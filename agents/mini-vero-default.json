{
  "family": "mini-vero",
  "mode": "proof",
  "step_limit": 200,
  "max_consecutive_format_errors": 3,
  "executor": {
    "timeout_seconds": 600,
    "env": [["PAGER", "cat"], ["MANPAGER", "cat"], ["LESS", "-R"], ["PIP_PROGRESS_BAR", "off"], ["TQDM_DISABLE", "1"]]
  },
  "recover_output": false
}
